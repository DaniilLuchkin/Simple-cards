generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  // Language codes (see web/src/lib/i18n LANGUAGES). learningLanguage is the
  // vocabulary being studied; translationLanguage is what cards translate into;
  // interfaceLanguage is the Mini App UI language (null = let the client pick).
  learningLanguage    String  @default("en")
  translationLanguage String  @default("ru")
  interfaceLanguage   String?
  // Target number of reviews per day for the streak/heatmap.
  dailyGoal Int @default(10)

  // When the daily word-of-the-day message was last sent to this user.
  lastWordOfDayAt DateTime?

  cards      Card[]
  reviewDays ReviewDay[]
}

// One row per user per day they reviewed cards. `count` drives the streak
// heatmap; a day counts toward the streak when count >= the user's dailyGoal.
model ReviewDay {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Calendar day at UTC midnight.
  day   DateTime @db.Date
  count Int      @default(0)

  @@unique([userId, day])
}

enum CardStatus {
  ACTIVE
  GENERATING
  FAILED
}

model Card {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // word == headword. example is the filled sentence (derived from `sentence`
  // when present) so the library preview stays readable.
  word        String
  example     String
  explanation String
  translation String
  imageUrl    String?

  // Rich SRS fields (added later; nullable/defaulted so pre-existing cards are
  // valid). `sentence` is the cloze form containing "{{gap}}".
  ipa          String?
  pos          String?
  forms        String[] @default([])
  collocations String[] @default([])
  sentence     String?
  personalNote String   @default("")

  status CardStatus @default(ACTIVE)

  // SM2 scheduling state (easeFactor == ease, repetitions == reps).
  easeFactor   Float    @default(2.5)
  interval     Int      @default(0)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueAt])
}
