generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  createdAt  DateTime @default(now())

  // Language codes (see web/src/lib/i18n LANGUAGES). learningLanguage is the
  // vocabulary being studied; translationLanguage is what cards translate into;
  // interfaceLanguage is the Mini App UI language (null = let the client pick).
  learningLanguage    String  @default("en")
  translationLanguage String  @default("ru")
  interfaceLanguage   String?
  // Target number of reviews per day for the streak/heatmap.
  dailyGoal Int @default(10)
  // IANA timezone (e.g. "Europe/Berlin") auto-detected by the Mini App; day
  // boundaries for the streak/heatmap are computed here. null => UTC.
  timezone String?
  // Whether the daily "word of the day" message is sent to this user.
  wordOfDayEnabled Boolean @default(true)

  // CEFR self-assessed level and goal. currentLevel A0..C2, targetLevel A1..C2.
  // Used to aim generated vocabulary at the right difficulty band.
  currentLevel String @default("A0")
  targetLevel  String @default("B1")

  // When the daily word-of-the-day message was last sent to this user.
  lastWordOfDayAt DateTime?

  // Daily streak reminder (a bot nudge at REMINDER_LOCAL_HOUR local time when
  // the day's goal isn't met yet).
  reminderEnabled Boolean   @default(true)
  lastReminderAt  DateTime?

  // The user id (this table) who referred this user, set once on first /start
  // via a ref link. Plain column (no relation) - we only count referrals.
  referredById String?

  // Streak freezes: earned by completing a day's quests, spent automatically to
  // cover a missed day so the streak survives.
  streakFreezes Int @default(0)

  cards      Card[]
  reviewDays ReviewDay[]
}

// One row per user per day they reviewed cards. `count` drives the streak
// heatmap; a day counts toward the streak when count >= the user's dailyGoal.
model ReviewDay {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Calendar day at UTC midnight.
  day   DateTime @db.Date
  count Int      @default(0)

  // Per-day play stats, the source the daily quests are derived from.
  sessions   Int @default(0) // completed review sessions
  bestCombo  Int @default(0) // longest correct streak within one session
  newLearned Int @default(0) // cards that crossed the "learned" interval today

  // A day covered by a spent streak freeze: no reviews, but the streak holds.
  frozen Boolean @default(false)
  // Whether the day's "all quests done" reward was already granted.
  questsRewarded Boolean @default(false)

  @@unique([userId, day])
}

enum CardStatus {
  ACTIVE
  GENERATING
  FAILED
}

model Card {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // word == headword. example is the filled sentence (derived from `sentence`
  // when present) so the library preview stays readable.
  word        String
  example     String
  explanation String
  translation String
  imageUrl    String?

  // Rich SRS fields (added later; nullable/defaulted so pre-existing cards are
  // valid). `sentence` is the cloze form containing "{{gap}}".
  ipa          String?
  pos          String?
  forms        String[] @default([])
  collocations String[] @default([])
  sentence     String?
  personalNote String   @default("")

  status CardStatus @default(ACTIVE)

  // SM2 scheduling state (easeFactor == ease, repetitions == reps).
  easeFactor   Float    @default(2.5)
  interval     Int      @default(0)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueAt])
}
