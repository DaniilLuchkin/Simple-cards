# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS URL of the deployed Mini App (used for the bot's "Open Simple Cards" button)
MINI_APP_URL=https://your-mini-app.example.com

# Server
PORT=3000
# Comma-separated list of origins allowed to call the API (your Mini App origin)
CORS_ORIGIN=https://your-mini-app.example.com

# Database
DATABASE_URL=postgresql://simplecards:simplecards@localhost:5432/simplecards

# OpenRouter (LLM card generation) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_SITE_URL=https://your-mini-app.example.com
OPENROUTER_APP_NAME=Simple Cards

# S3-compatible object storage (MinIO locally, or any S3-compatible provider in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=simple-cards
S3_ACCESS_KEY_ID=simplecards
S3_SECRET_ACCESS_KEY=simplecards123
S3_FORCE_PATH_STYLE=true
# Public base URL used to build image links served back to the client
S3_PUBLIC_URL=http://localhost:9000/simple-cards
