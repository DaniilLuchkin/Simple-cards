# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Public URL of this app (bot's "Open Simple Cards" button + allowed CORS
# origin). In production it is derived from APP_DOMAIN - see the root
# .env.example; here it is set explicitly for local development.
MINI_APP_URL=http://localhost:3000
# Usually left unset (defaults to MINI_APP_URL). Only needed if the API and
# the Mini App are served from different origins.
# CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://simplecards:simplecards@localhost:5432/simplecards

# OpenRouter (LLM card generation) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx
# Any OpenRouter model slug. Photo cards need a vision-capable model.
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Image-capable model used for "generate image" on a card (must return an image).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
OPENROUTER_APP_NAME=Simple Cards

# Where uploaded card images are stored on disk. In Docker this points at the
# mounted volume (/data/uploads); locally a relative path is fine.
UPLOADS_DIR=uploads

# Origin serving /uploads (this server). Defaults to APP_DOMAIN, falling back to
# MINI_APP_URL - only set it if images are served from somewhere else.
# PUBLIC_ORIGIN=https://api.example.com
