# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# Public HTTPS URL of this app (bot's "Open Simple Cards" button + allowed CORS
# origin). On Railway this is auto-detected from RAILWAY_PUBLIC_DOMAIN once you
# generate a domain for the service - only set this manually for local dev.
MINI_APP_URL=http://localhost:3000
# Usually left unset (defaults to MINI_APP_URL). Only needed if the API and
# the Mini App are served from different origins.
# CORS_ORIGIN=http://localhost:5173

# Server
PORT=3000

# Database
DATABASE_URL=postgresql://simplecards:simplecards@localhost:5432/simplecards

# OpenRouter (LLM card generation) - https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_APP_NAME=Simple Cards

# Where uploaded card images are stored on disk. Point this at a mounted
# Railway volume (e.g. /data/uploads) for images to survive redeploys.
UPLOADS_DIR=uploads

# Origin serving /uploads (this server). Defaults to the Railway domain (or
# MINI_APP_URL locally) - only set it if images are served from somewhere else.
# PUBLIC_ORIGIN=https://api.example.com
