# ---------------------------------------------------------------------------
# Production environment for docker-compose.prod.yml.
#
#   cp .env.example .env && chmod 600 .env
#
# This file is read twice: for ${VAR} interpolation in docker-compose.prod.yml
# and as env_file for the app container. Avoid '$' and quotes inside values.
# For local development use server/.env instead (see server/.env.example).
# ---------------------------------------------------------------------------

# --- Public host -----------------------------------------------------------
# The public host of this deployment. Caddy gets its TLS certificate for it and
# the server derives MINI_APP_URL / PUBLIC_ORIGIN / the CORS origin from it
# (server/src/env.ts), so switching domains is this one line.
# Telegram only opens a Mini App over HTTPS with a valid certificate, so a bare
# IP will not work. A free DuckDNS subdomain is fine.
APP_DOMAIN=simple-cards.duckdns.org
# Let's Encrypt uses this for expiry notices. Must not be empty.
ACME_EMAIL=you@example.com

# --- Telegram --------------------------------------------------------------
# @BotFather -> /newbot. The bot uses long polling, so exactly one process may
# hold this token at a time - a second one gets HTTP 409 from Telegram.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# --- Database --------------------------------------------------------------
# Postgres runs on the compose network and is not published to the host, so
# this password never leaves the VM.
POSTGRES_USER=simplecards
POSTGRES_DB=simplecards
POSTGRES_PASSWORD=replace-with-a-long-random-string
# Must match the three values above. The host is the compose service name.
DATABASE_URL=postgresql://simplecards:replace-with-a-long-random-string@postgres:5432/simplecards?schema=public

# --- OpenRouter (LLM) ------------------------------------------------------
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxx
# Any OpenRouter slug. Photo cards need a vision-capable model.
#OPENROUTER_MODEL=openai/gpt-5.6-luna
# Must be able to return an image ("generate image" on a card).
#OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
#OPENROUTER_APP_NAME=Simple Cards

# --- Uploaded card images --------------------------------------------------
# Host directory bind-mounted at /data/uploads. Backing up the images is a tar
# of this path. It must be owned by uid 1000 (the `node` user in the image):
#   sudo mkdir -p /opt/simple-cards/uploads
#   sudo chown -R 1000:1000 /opt/simple-cards/uploads
UPLOADS_HOST_DIR=/opt/simple-cards/uploads

# --- Backups (backup.sh) ---------------------------------------------------
#BACKUP_DIR=/opt/simple-cards/backups
#BACKUP_RETENTION_DAYS=14

# --- Optional overrides ----------------------------------------------------
# All three default to https://$APP_DOMAIN. Only set them if the Mini App, the
# API or the images are served from a different origin.
#MINI_APP_URL=
#PUBLIC_ORIGIN=
#CORS_ORIGIN=
# UTC hour for the daily word of the day (9 = 12:00 MSK).
#WORD_OF_DAY_UTC_HOUR=9
# Hour in each user's own timezone for the streak reminder.
#REMINDER_LOCAL_HOUR=19
# PORT and UPLOADS_DIR are set by docker-compose.prod.yml - don't set them here.
